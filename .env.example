# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=mavu_app
DB_PASSWORD=change-me
DB_NAME=mavu_mill

# Used to sign login tokens — make this a long random string.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the server listens on (most hosts set this automatically)
PORT=4000
