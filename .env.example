# Copy this file to .env and fill in real values. Never commit .env.

# ── DATABASE ────────────────────────────────────────────────
# Option A: individual fields (typical for local development)
DB_HOST=localhost
DB_PORT=3306
DB_USER=mavu_app
DB_PASSWORD=change-me
DB_NAME=mavu_mill

# Option B: a single connection URL (many cloud hosts give you this).
# If DATABASE_URL is set, it takes priority over the fields above.
# DATABASE_URL=mysql://user:password@host:3306/dbname

# ── SSL (required by most cloud MySQL providers) ─────────────
# Leave false for a local database. Set true when connecting to a
# cloud provider such as Aiven, PlanetScale or Railway.
DB_SSL=false

# If your provider gives you a CA certificate file, point to it here.
# This is the most secure option — without it, the connection is still
# encrypted but the server's identity isn't verified.
# DB_SSL_CA_PATH=./ca.pem
# Or paste the certificate contents directly (some hosts inject this):
# DB_SSL_CA=

# ── AUTH ────────────────────────────────────────────────────
# Used to sign login tokens — make this a long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Used to sign refresh tokens (different from JWT_SECRET).
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# ── SERVER ──────────────────────────────────────────────────
# Port the server listens on (most hosts set this automatically)
PORT=4000

# ── EMAIL OTP & NOTIFICATIONS (Free Gmail SMTP) ───────────────
# To send real emails with Gmail for free (up to 500 emails/day):
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password (name it "Sakthi Mill App")
# 4. Paste the 16-character password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-mill-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM="சக்தி ஆலை" <your-mill-email@gmail.com>
